  fun _p_dash(cp: U32): Bool =>
    match cp >> 12
    | 0x0000 =>
      match cp
      | let c: U32 if c <= 0x002C => false
      | let c: U32 if c <= 0x002D => true
      | let c: U32 if c <= 0x0589 => false
      | let c: U32 if c <= 0x058A => true
      | let c: U32 if c <= 0x05BD => false
      | let c: U32 if c <= 0x05BE => true
      else false
      end
    | 0x0001 =>
      match cp
      | let c: U32 if c <= 0x13FF => false
      | let c: U32 if c <= 0x1400 => true
      | let c: U32 if c <= 0x1805 => false
      | let c: U32 if c <= 0x1806 => true
      else false
      end
    | 0x0002 =>
      match cp
      | let c: U32 if c <= 0x200F => false

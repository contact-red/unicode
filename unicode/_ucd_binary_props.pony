      | let c: U32 if c <= 0xFF0C => false
      | let c: U32 if c <= 0xFF0D => true
      else false
      end
    | 0x0010 =>
      match cp
      | let c: U32 if c <= 0x10D6D => false
      | let c: U32 if c <= 0x10D6E => true
      | let c: U32 if c <= 0x10EAC => false

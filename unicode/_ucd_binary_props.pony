      | let c: U32 if c <= 0x202F => true
      | let c: U32 if c <= 0x205E => false
      | let c: U32 if c <= 0x205F => true
      else false
      end
    | 0x0003 =>
      match cp
      | let c: U32 if c <= 0x3000 => true
      else false
      end
    else
      false
    end


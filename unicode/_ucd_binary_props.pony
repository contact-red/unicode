  fun _p_join_control(cp: U32): Bool =>
    match cp >> 12
    | 0x0002 =>
      match cp
      | let c: U32 if c <= 0x200B => false
      | let c: U32 if c <= 0x200D => true
      else false
      end
    else
      false
    end

  fun _p_logical_order_exception(cp: U32): Bool =>
    match cp >> 12
    | 0x0000 =>
      match cp
      | let c: U32 if c <= 0x0E3F => false
      | let c: U32 if c <= 0x0E44 => true
      | let c: U32 if c <= 0x0EBF => false
      | let c: U32 if c <= 0x0EC4 => true
      else false
      end
    | 0x0001 =>
      match cp
      | let c: U32 if c <= 0x19B4 => false
      | let c: U32 if c <= 0x19B7 => true
      | let c: U32 if c <= 0x19B9 => false
      | let c: U32 if c <= 0x19BA => true
      else false
      end
    | 0x000A =>
      match cp
      | let c: U32 if c <= 0xAAB4 => false
      | let c: U32 if c <= 0xAAB6 => true
      | let c: U32 if c <= 0xAAB8 => false
      | let c: U32 if c <= 0xAAB9 => true
      | let c: U32 if c <= 0xAABA => false
      | let c: U32 if c <= 0xAABC => true
      else false
      end
    else
      false
    end


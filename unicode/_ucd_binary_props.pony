  fun _p_variation_selector(cp: U32): Bool =>
    match cp >> 12
    | 0x0001 =>
      match cp
      | let c: U32 if c <= 0x180A => false
      | let c: U32 if c <= 0x180D => true
      | let c: U32 if c <= 0x180E => false
      | let c: U32 if c <= 0x180F => true
      else false
      end
    | 0x000F =>
      match cp
      | let c: U32 if c <= 0xFDFF => false
      | let c: U32 if c <= 0xFE0F => true
      else false
      end
    | 0x00E0 =>
      match cp
      | let c: U32 if c <= 0xE00FF => false
      | let c: U32 if c <= 0xE01EF => true
      else false
      end
    else
      false
    end

  fun _p_white_space(cp: U32): Bool =>
    match cp >> 12
    | 0x0000 =>
      match cp
      | let c: U32 if c <= 0x0008 => false
      | let c: U32 if c <= 0x000D => true
      | let c: U32 if c <= 0x001F => false
      | let c: U32 if c <= 0x0020 => true
      | let c: U32 if c <= 0x0084 => false
      | let c: U32 if c <= 0x0085 => true
      | let c: U32 if c <= 0x009F => false
      | let c: U32 if c <= 0x00A0 => true
      else false
      end
    | 0x0001 =>
      match cp
      | let c: U32 if c <= 0x167F => false
      | let c: U32 if c <= 0x1680 => true
      else false
      end
    | 0x0002 =>
      match cp
      | let c: U32 if c <= 0x200A => true
      | let c: U32 if c <= 0x2027 => false
      | let c: U32 if c <= 0x2029 => true

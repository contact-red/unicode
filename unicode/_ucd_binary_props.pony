  fun _p_bidi_control(cp: U32): Bool =>
    match cp >> 12
    | 0x0000 =>
      match cp
      | let c: U32 if c <= 0x061B => false
      | let c: U32 if c <= 0x061C => true
      else false
      end
    | 0x0002 =>
      match cp
      | let c: U32 if c <= 0x200D => false
      | let c: U32 if c <= 0x200F => true
      | let c: U32 if c <= 0x2029 => false
      | let c: U32 if c <= 0x202E => true
      | let c: U32 if c <= 0x2065 => false
      | let c: U32 if c <= 0x2069 => true
      else false
      end
    else
      false
    end


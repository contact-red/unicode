  fun _p_noncharacter_code_point(cp: U32): Bool =>
    match cp >> 12
    | 0x000F =>
      match cp
      | let c: U32 if c <= 0xFDCF => false
      | let c: U32 if c <= 0xFDEF => true
      | let c: U32 if c <= 0xFFFD => false
      | let c: U32 if c <= 0xFFFF => true
      else false
      end
    | 0x001F =>
      match cp
      | let c: U32 if c <= 0x1FFFD => false
      | let c: U32 if c <= 0x1FFFF => true
      else false
      end
    | 0x002F =>
      match cp
      | let c: U32 if c <= 0x2FFFD => false
      | let c: U32 if c <= 0x2FFFF => true
      else false
      end
    | 0x003F =>
      match cp
      | let c: U32 if c <= 0x3FFFD => false
      | let c: U32 if c <= 0x3FFFF => true
      else false
      end
    | 0x004F =>
      match cp
      | let c: U32 if c <= 0x4FFFD => false
      | let c: U32 if c <= 0x4FFFF => true
      else false
      end
    | 0x005F =>
      match cp
      | let c: U32 if c <= 0x5FFFD => false
      | let c: U32 if c <= 0x5FFFF => true
      else false
      end
    | 0x006F =>
      match cp
      | let c: U32 if c <= 0x6FFFD => false
      | let c: U32 if c <= 0x6FFFF => true
      else false
      end
    | 0x007F =>
      match cp
      | let c: U32 if c <= 0x7FFFD => false
      | let c: U32 if c <= 0x7FFFF => true
      else false
      end
    | 0x008F =>
      match cp
      | let c: U32 if c <= 0x8FFFD => false
      | let c: U32 if c <= 0x8FFFF => true
      else false
      end
    | 0x009F =>
      match cp
      | let c: U32 if c <= 0x9FFFD => false
      | let c: U32 if c <= 0x9FFFF => true
      else false
      end
    | 0x00AF =>
      match cp
      | let c: U32 if c <= 0xAFFFD => false
      | let c: U32 if c <= 0xAFFFF => true
      else false
      end
    | 0x00BF =>
      match cp
      | let c: U32 if c <= 0xBFFFD => false
      | let c: U32 if c <= 0xBFFFF => true
      else false
      end
    | 0x00CF =>
      match cp
      | let c: U32 if c <= 0xCFFFD => false
      | let c: U32 if c <= 0xCFFFF => true
      else false
      end
    | 0x00DF =>
      match cp
      | let c: U32 if c <= 0xDFFFD => false
      | let c: U32 if c <= 0xDFFFF => true
      else false
      end
    | 0x00EF =>
      match cp
      | let c: U32 if c <= 0xEFFFD => false
      | let c: U32 if c <= 0xEFFFF => true
      else false
      end
    | 0x00FF =>
      match cp
      | let c: U32 if c <= 0xFFFFD => false
      | let c: U32 if c <= 0xFFFFF => true
      else false
      end
    | 0x010F =>
      match cp
      | let c: U32 if c <= 0x10FFFD => false
      | let c: U32 if c <= 0x10FFFF => true
      else false
      end
    else
      false
    end


      | let c: U32 if c <= 0x2E5C => false
      | let c: U32 if c <= 0x2E5D => true
      else false
      end
    | 0x0003 =>
      match cp
      | let c: U32 if c <= 0x301B => false
      | let c: U32 if c <= 0x301C => true
      | let c: U32 if c <= 0x302F => false
      | let c: U32 if c <= 0x3030 => true
      | let c: U32 if c <= 0x309F => false
      | let c: U32 if c <= 0x30A0 => true

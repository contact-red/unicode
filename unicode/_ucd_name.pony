  fun from_name(name: String box): (U32 | None) =>
    """
    Linear-scan reverse lookup. O(n) over ~30k entries.
    For interactive use only; not on hot paths.
    """
    let cps = _cps()
    let count = cps.size() / 8
    var i: USize = 0
    while i < count do
      let base = i * 8
      try
        let cp: U32 =
          _UcdHex.byte(cps, base)?
            or (_UcdHex.byte(cps, base + 2)? << 8)
            or (_UcdHex.byte(cps, base + 4)? << 16)
            or (_UcdHex.byte(cps, base + 6)? << 24)
        match of(cp)
        | let n: String val if n == name => return cp
        end
      end
      i = i + 1
    end
    None

  fun _cps(): String val =>
    ""

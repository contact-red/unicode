      | let c: U32 if c <= 0x1F169 => WBALetter
      | let c: U32 if c <= 0x1F16B => WBOther
      | let c: U32 if c <= 0x1F16F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F189 => WBALetter
      | let c: U32 if c <= 0x1F171 => WBExtendedPictographic
      | let c: U32 if c <= 0x1F17D => WBOther
      | let c: U32 if c <= 0x1F17F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F18D => WBOther
      | let c: U32 if c <= 0x1F18E => WBExtendedPictographic
      | let c: U32 if c <= 0x1F190 => WBOther
      | let c: U32 if c <= 0x1F19A => WBExtendedPictographic
      | let c: U32 if c <= 0x1F1AC => WBOther
      | let c: U32 if c <= 0x1F1E5 => WBExtendedPictographic
      | let c: U32 if c <= 0x1F1FF => WBRegionalIndicator
      | let c: U32 if c <= 0x1F200 => WBOther
      | let c: U32 if c <= 0x1F20F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F219 => WBOther
      | let c: U32 if c <= 0x1F21A => WBExtendedPictographic
      | let c: U32 if c <= 0x1F22E => WBOther
      | let c: U32 if c <= 0x1F22F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F231 => WBOther
      | let c: U32 if c <= 0x1F23A => WBExtendedPictographic
      | let c: U32 if c <= 0x1F23B => WBOther
      | let c: U32 if c <= 0x1F23F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F248 => WBOther
      | let c: U32 if c <= 0x1F3FA => WBExtendedPictographic
      | let c: U32 if c <= 0x1F3FF => WBExtend
      | let c: U32 if c <= 0x1F53D => WBExtendedPictographic
      | let c: U32 if c <= 0x1F545 => WBOther
      | let c: U32 if c <= 0x1F64F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F67F => WBOther
      | let c: U32 if c <= 0x1F6FF => WBExtendedPictographic
      | let c: U32 if c <= 0x1F773 => WBOther
      | let c: U32 if c <= 0x1F77F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F7D4 => WBOther
      | let c: U32 if c <= 0x1F7FF => WBExtendedPictographic
      | let c: U32 if c <= 0x1F80B => WBOther
      | let c: U32 if c <= 0x1F80F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F847 => WBOther
      | let c: U32 if c <= 0x1F84F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F859 => WBOther
      | let c: U32 if c <= 0x1F85F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F887 => WBOther
      | let c: U32 if c <= 0x1F88F => WBExtendedPictographic
      | let c: U32 if c <= 0x1F8AD => WBOther
      | let c: U32 if c <= 0x1F8FF => WBExtendedPictographic
      | let c: U32 if c <= 0x1F90B => WBOther
      | let c: U32 if c <= 0x1F93A => WBExtendedPictographic
      | let c: U32 if c <= 0x1F93B => WBOther
      | let c: U32 if c <= 0x1F945 => WBExtendedPictographic
      | let c: U32 if c <= 0x1F946 => WBOther
      | let c: U32 if c <= 0x1FAFF => WBExtendedPictographic
      | let c: U32 if c <= 0x1FBEF => WBOther
      | let c: U32 if c <= 0x1FBF9 => WBNumeric
      | let c: U32 if c <= 0x1FBFF => WBOther
      | let c: U32 if c <= 0x1FFFD => WBExtendedPictographic
      else WBOther
      end
    | 0x00E0 =>
      match cp
      | let c: U32 if c <= 0xE0000 => WBOther
      | let c: U32 if c <= 0xE0001 => WBFormat
      | let c: U32 if c <= 0xE001F => WBOther
      | let c: U32 if c <= 0xE007F => WBExtend
      | let c: U32 if c <= 0xE00FF => WBOther
      | let c: U32 if c <= 0xE01EF => WBExtend
      else WBOther
      end
    else
      WBOther
    end

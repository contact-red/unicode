// Grapheme_Cluster_Break property table generator.
//
// Source files:
//   - ucd/auxiliary/GraphemeBreakProperty.txt (13 of 14 values)
//   - ucd/emoji/emoji-data.txt → Extended_Pictographic
//
// Combined into a single sorted, coalesced array of (range_lo, range_hi,
// break_byte) records and emitted as a single `match` statement on `cp`.
// Each coalesced range becomes one match arm:
//
//     | let c: U32 if (c >= 0xLO) and (c <= 0xHI) => GBVariant
//
// Codepoints not covered by any arm fall through to the `else GBOther`
// branch. The match form replaces the previous hex-blob-plus-binary-
// search lookup; with sorted arms the early arms cover the ASCII range,
// so common Latin-script text resolves in a few comparisons.

primitive GraphemeBreakTableEmitter
  fun emit(
    gbp_lines: ReadSeq[String val] box,
    emoji_lines: ReadSeq[String val] box)
    : String iso^ ?
  =>
    """
    Generate the contents of `unicode/_ucd_grapheme_break.pony`.
    Combines entries from both source files; raises on malformed input.
    """
    let merged = _collect(gbp_lines, emoji_lines)?
    recover iso
      let out = String(256 * 1024)
      out.append("// Auto-generated by unicode-build. Do not edit by hand.\n")
      out.append("// Regenerate via:\n")
      out.append("//   make ucd-generate\n")
      out.append("//\n")
      out.append("// Sources: auxiliary/GraphemeBreakProperty.txt +\n")
      out.append("// emoji/emoji-data.txt (Extended_Pictographic only).\n")
      out.append("// Codepoints outside any range default to GBOther.\n\n")

      out.append("primitive _UcdGraphemeBreak\n")
      out.append("  fun of(cp: U32): GraphemeBreak =>\n")
      // Two-level dispatch. Top-level: `match cp >> 12` picks a
      // 4096-cp bucket (no guards — Pony / LLVM can emit a switch).
      // Inner: a linear `c <= upper` chain over the (sub-)ranges
      // inside that bucket. Ranges that span more than one bucket
      // get split first so every emitted entry stays inside exactly
      // one bucket.
      let split = _split_at_buckets(merged)
      out.append("    match cp >> 12\n")
      var prev_bucket: U32 = 0xFFFFFFFF
      var bucket_open: Bool = false
      var prev_hi_plus_1: U32 = 0
      for r in split.values() do
        let bucket = r._1 >> 12
        if bucket != prev_bucket then
          if bucket_open then
            out.append("      else GBOther\n")
            out.append("      end\n")
          end
          out.append("    | 0x")
          _emit_hex_u32(out, bucket)
          out.append(" =>\n")
          out.append("      match cp\n")
          prev_hi_plus_1 = bucket << 12
          bucket_open = true
          prev_bucket = bucket
        end
        if r._1 > prev_hi_plus_1 then
          out.append("      | let c: U32 if c <= 0x")
          _emit_hex_u32(out, r._1 - 1)
          out.append(" => GBOther\n")
        end
        out.append("      | let c: U32 if c <= 0x")
        _emit_hex_u32(out, r._2)
        out.append(" => ")
        out.append(_byte_to_variant(r._3))
        out.append("\n")
        prev_hi_plus_1 = r._2 + 1
      end
      if bucket_open then
        out.append("      else GBOther\n")
        out.append("      end\n")
      end
      out.append("    else\n")
      out.append("      GBOther\n")
      out.append("    end\n")

      out
    end

  fun _split_at_buckets(
    merged: Array[(U32, U32, U8)] val): Array[(U32, U32, U8)] val
  =>
    """
    Split every input range so each output sub-range stays inside one
    4096-cp bucket (top 20 - 12 = 20 bits all the same after
    `>> 12`). The split preserves the input ordering so the result is
    still sorted by `range_lo`.
    """
    recover val
      let out = Array[(U32, U32, U8)]
      for r in merged.values() do
        var lo = r._1
        while lo <= r._2 do
          let bucket = lo >> 12
          let bucket_end = ((bucket + 1) << 12) - 1
          let hi = if r._2 < bucket_end then r._2 else bucket_end end
          out.push((lo, hi, r._3))
          lo = hi + 1
        end
      end
      out
    end

  fun _byte_to_variant(b: U8): String val =>
    """
    Map the emitter-side property byte (see grapheme_break_codes.pony)
    to the runtime `GraphemeBreak` variant name. Unknown bytes fall to
    `GBOther` so a stale source file never produces malformed code.
    """
    match b
    | U8(1) => "GBCR"
    | U8(2) => "GBLF"
    | U8(3) => "GBControl"
    | U8(4) => "GBExtend"
    | U8(5) => "GBZWJ"
    | U8(6) => "GBRegionalIndicator"
    | U8(7) => "GBPrepend"
    | U8(8) => "GBSpacingMark"
    | U8(9) => "GBL"
    | U8(10) => "GBV"
    | U8(11) => "GBT"
    | U8(12) => "GBLV"
    | U8(13) => "GBLVT"
    | U8(14) => "GBExtendedPictographic"
    else "GBOther"
    end

  fun _emit_hex_u32(out: String ref, value: U32) =>
    let digits = "0123456789ABCDEF"
    let nibbles = recover ref Array[U8](8) end
    var n = value
    if n == 0 then nibbles.push('0') end
    while n > 0 do
      try nibbles.push(digits(USize.from[U32](n and 0xF))?) end
      n = n >> 4
    end
    // Pad to at least 4 hex chars for readability.
    while nibbles.size() < 4 do nibbles.push('0') end
    var i = nibbles.size()
    while i > 0 do
      try out.push(nibbles(i - 1)?) end
      i = i - 1
    end

  fun _collect(
    gbp_lines: ReadSeq[String val] box,
    emoji_lines: ReadSeq[String val] box)
    : Array[(U32, U32, U8)] val ?
  =>
    """
    Parse both source files; keep only entries whose property maps to a
    known byte (everything from GraphemeBreakProperty.txt, plus
    Extended_Pictographic from emoji-data.txt). Sort by range_lo and
    coalesce adjacent equal-byte ranges to keep the table compact.
    """
    let raw = recover trn Array[(U32, U32, U8)] end
    for e in PropertyFileParser.parse_all(gbp_lines)?.values() do
      match GraphemeBreakCodes.to_byte(e.property)
      | let b: U8 => raw.push((e.range_lo, e.range_hi, b))
      | None => None
      end
    end
    for e in PropertyFileParser.parse_all(emoji_lines)?.values() do
      if e.property == "Extended_Pictographic" then
        match GraphemeBreakCodes.to_byte(e.property)
        | let b: U8 => raw.push((e.range_lo, e.range_hi, b))
        | None => None
        end
      end
    end

    // Sort by range_lo then coalesce adjacent equal-byte ranges. This
    // is a small enough N (~1000) that an insertion-sort-by-bubbling
    // pass is fine; production codegen runs in milliseconds.
    let sorted = recover trn Array[(U32, U32, U8)] end
    for entry in (consume raw).values() do
      var i: USize = 0
      var inserted: Bool = false
      while i < sorted.size() do
        try
          let s = sorted(i)?
          if entry._1 < s._1 then
            try sorted.insert(i, entry)? end
            inserted = true
            break
          end
        end
        i = i + 1
      end
      if not inserted then sorted.push(entry) end
    end

    let coalesced = recover trn Array[(U32, U32, U8)] end
    var cur_lo: U32 = 0
    var cur_hi: U32 = 0
    var cur_b: U8 = 0
    var have_cur: Bool = false
    for entry in sorted.values() do
      if have_cur and (entry._1 == (cur_hi + 1)) and (entry._3 == cur_b) then
        cur_hi = entry._2
      else
        if have_cur then coalesced.push((cur_lo, cur_hi, cur_b)) end
        cur_lo = entry._1
        cur_hi = entry._2
        cur_b = entry._3
        have_cur = true
      end
    end
    if have_cur then coalesced.push((cur_lo, cur_hi, cur_b)) end
    consume coalesced

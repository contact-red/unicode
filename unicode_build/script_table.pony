// Script table generator.
//
// Generates two files in lockstep:
//
//   unicode/script.pony       — the closed-union `Script` type, one
//                               primitive per UCD script name, plus
//                               the `Scripts` helper (from_iso, byte
//                               codecs). Auto-generated so every UCD
//                               version refresh is mechanical.
//
//   unicode/_ucd_script.pony  — cp-range → script-byte lookup table,
//                               coalesced and binary-searched at
//                               runtime. Same ASCII-hex-pair encoding
//                               as the other UCD tables.
//
// Both files use the same byte encoding for script names; the byte
// codes are assigned alphabetically over the set of names present in
// Scripts.txt. Byte 0 is always `Unknown` (the default for codepoints
// not covered by any range).

primitive ScriptTableEmitter
  fun emit_both(lines: ReadSeq[String val] box)
    : (String iso^, String iso^) ?
  =>
    """
    Parse Scripts.txt and return both file bodies as a tuple
    (script_runtime, ucd_script_table).
    """
    let entries = PropertyFileParser.parse_all(lines)?
    let names = collect_names(entries)
    let ranges = _coalesce_ranges(entries, names)
    let runtime = _emit_runtime(names)
    let table = _emit_table(ranges, names)
    (consume runtime, consume table)

  fun collect_names(
    entries: ReadSeq[PropertyEntry val] box)
    : Array[String val] val
  =>
    """
    Distinct script names from the parsed entries, sorted alphabetically
    with `Unknown` forced to position 0 (so codepoints outside any
    range decode to it via the default-zero byte).
    """
    let seen = recover trn Array[String val] end
    seen.push("Unknown")
    for e in entries.values() do
      var found: Bool = false
      for n in seen.values() do
        if n == e.property then found = true; break end
      end
      if not found then seen.push(e.property) end
    end
    // Insertion-sort positions 1..end (keep Unknown at index 0)
    let n = seen.size()
    var i: USize = 2
    while i < n do
      try
        var j = i
        let cur = seen(j)?
        while (j > 1) and (seen(j - 1)? > cur) do
          seen(j)? = seen(j - 1)?
          j = j - 1
        end
        seen(j)? = cur
      end
      i = i + 1
    end
    let out = recover trn Array[String val](seen.size()) end
    for n2 in seen.values() do out.push(n2) end
    consume out

  fun _coalesce_ranges(
    entries: ReadSeq[PropertyEntry val] box,
    names: Array[String val] val)
    : Array[(U32, U32, U8)] val
  =>
    """
    Sort entries by range_lo, coalesce adjacent ranges with the same
    script-byte, and emit (lo, hi, byte) triples. Property files
    already enumerate non-overlapping ranges per UAX #44.
    """
    let raw = recover trn Array[(U32, U32, U8)] end
    for e in entries.values() do
      let b = _name_to_byte(names, e.property)
      raw.push((e.range_lo, e.range_hi, b))
    end
    // Sort by range_lo
    let n = raw.size()
    var i: USize = 1
    while i < n do
      try
        var j = i
        let cur = raw(j)?
        while (j > 0) and (raw(j - 1)?._1 > cur._1) do
          raw(j)? = raw(j - 1)?
          j = j - 1
        end
        raw(j)? = cur
      end
      i = i + 1
    end
    // Coalesce adjacent same-byte ranges
    let out = recover trn Array[(U32, U32, U8)] end
    var cur_lo: U32 = 0
    var cur_hi: U32 = 0
    var cur_b:  U8 = 0
    var have: Bool = false
    for r in raw.values() do
      if have and (r._3 == cur_b) and (r._1 == (cur_hi + 1)) then
        cur_hi = r._2
      else
        if have then out.push((cur_lo, cur_hi, cur_b)) end
        cur_lo = r._1; cur_hi = r._2; cur_b = r._3
        have = true
      end
    end
    if have then out.push((cur_lo, cur_hi, cur_b)) end
    consume out

  fun _name_to_byte(names: Array[String val] val, name: String val): U8 =>
    var i: USize = 0
    let n = names.size()
    while i < n do
      try
        if names(i)? == name then return U8.from[USize](i) end
      end
      i = i + 1
    end
    0  // Unknown

  fun _emit_runtime(names: Array[String val] val): String iso^ =>
    """
    Emit `unicode/script.pony` — one primitive per script, the
    `Script` closed union, and the private `_ScriptCodec` helper.
    Hand-written `Scripts` (in unicode/scripts.pony) delegates
    `from_iso` to `_ScriptCodec` and provides the ops API.
    """
    recover iso
      let out = String(32 * 1024)
      out.append("// Auto-generated by unicode-build. Do not edit by hand.\n")
      out.append("// Regenerate via:\n")
      out.append("//   make ucd-generate\n")
      out.append("//\n")
      out.append("// Source: Scripts.txt. The `Script` type is a closed\n")
      out.append("// union — exhaustive `match` is compile-checked. Every\n")
      out.append("// new Unicode version that adds a script is a\n")
      out.append("// semver-significant breaking change by design.\n\n")

      for n in names.values() do
        let tn = _type_name(n)
        out.append("primitive " + tn + "\n")
        out.append("  fun code(): String val => \"" + n + "\"\n")
        out.append("  fun string(): String val => \"" + n + "\"\n\n")
      end

      out.append("type Script is\n  ( ")
      var first: Bool = true
      for n in names.values() do
        if first then first = false
        else out.append("\n  | ")
        end
        out.append(_type_name(n))
      end
      out.append("\n  )\n\n")

      out.append("primitive _ScriptCodec\n")
      out.append("  fun from_iso(s: String box): (Script | None) =>\n")
      out.append("    match s\n")
      for n in names.values() do
        out.append("    | \"" + n + "\" => " + _type_name(n) + "\n")
      end
      out.append("    else None\n")
      out.append("    end\n\n")

      out.append("  fun to_byte(sc: Script): U8 =>\n")
      out.append("    match sc\n")
      var idx: USize = 0
      for n in names.values() do
        out.append("    | " + _type_name(n) + " => " + idx.string() + "\n")
        idx = idx + 1
      end
      out.append("    end\n\n")

      out.append("  fun from_byte(b: U8): Script =>\n")
      out.append("    match b\n")
      idx = 0
      for n in names.values() do
        out.append("    | " + idx.string() + " => " + _type_name(n) + "\n")
        idx = idx + 1
      end
      out.append("    else ScriptUnknown\n")
      out.append("    end\n")
      out
    end

  fun _type_name(name: String val): String val =>
    """
    Convert a UCD script name (which may contain underscores —
    "Anatolian_Hieroglyphs") into a Pony primitive name (no
    underscores allowed — "ScriptAnatolianHieroglyphs"). The
    original name with underscores is still returned by `code()`.
    """
    let out = recover trn String(name.size() + 6) end
    out.append("Script")
    for c in name.values() do
      if c != '_' then out.push(c) end
    end
    consume out

  fun _emit_table(
    ranges: Array[(U32, U32, U8)] val,
    names: Array[String val] val): String iso^
  =>
    """
    Emit `unicode/_ucd_script.pony` — the cp-range table as a two-
    level `match` (see `_RangeMatchEmitter`).
    """
    recover iso
      let out = String(256 * 1024)
      out.append("// Auto-generated by unicode-build. Do not edit by hand.\n")
      out.append("// Regenerate via:\n")
      out.append("//   make ucd-generate\n")
      out.append("//\n")
      out.append("// Source: Scripts.txt. Codepoints outside any range\n")
      out.append("// default to ScriptUnknown.\n\n")

      out.append("primitive _UcdScript\n")
      out.append("  fun of(cp: U32): Script =>\n")
      let to_variant: {(U8): String val} val =
        {(b: U8)(names): String val =>
          let idx = USize.from[U8](b)
          if idx >= names.size() then return "ScriptUnknown" end
          try ScriptTableEmitter._type_name(names(idx)?)
          else "ScriptUnknown"
          end
        }
      _RangeMatchEmitter.emit(out, ranges, to_variant, "ScriptUnknown")
      out
    end

  fun _emit_le_u32(out: String ref, value: U32) =>
    _emit_byte(out, U8.from[U32](value and 0xFF))
    _emit_byte(out, U8.from[U32]((value >> 8) and 0xFF))
    _emit_byte(out, U8.from[U32]((value >> 16) and 0xFF))
    _emit_byte(out, U8.from[U32]((value >> 24) and 0xFF))

  fun _emit_byte(out: String ref, b: U8) =>
    let digits = "0123456789ABCDEF"
    try out.push(digits(USize.from[U8](b >> 4))?) end
    try out.push(digits(USize.from[U8](b and 0xF))?) end

// Simple case-mapping tables.
//
// UnicodeData.txt fields 12/13/14 carry "simple" (single-codepoint to
// single-codepoint) Uppercase / Lowercase / Titlecase mappings. Per
// UAX #44, a codepoint maps to itself if no entry is given.
//
// Three tables, all emitted as a two-level `match cp >> 12` dispatch
// (see range_match_emitter.pony for the rationale). The default arm
// returns `cp` so the runtime API remains identity-preserving.

primitive CaseTableEmitter
  fun emit_simple_upper(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : (String iso^, String iso^)
  =>
    _emit_simple(entries, "_UcdSimpleUpper", "simple_upper", "ucd_su",
      "Simple_Uppercase_Mapping")

  fun emit_simple_lower(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : (String iso^, String iso^)
  =>
    _emit_simple(entries, "_UcdSimpleLower", "simple_lower", "ucd_sl",
      "Simple_Lowercase_Mapping")

  fun emit_simple_title(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : (String iso^, String iso^)
  =>
    _emit_simple(entries, "_UcdSimpleTitle", "simple_title", "ucd_st",
      "Simple_Titlecase_Mapping")

  fun _emit_simple(
    entries: ReadSeq[UnicodeDataEntry val] box,
    primitive_name: String val,
    kind: String val,
    c_prefix: String val,
    ucd_property: String val)
    : (String iso^, String iso^)
  =>
    let pairs = _collect(entries, kind)
    let values = SimpleCaseFoldEmitter.values_of(pairs)
    let header: String val =
      "// Auto-generated by unicode-build. Do not edit by hand.\n"
      + "// Regenerate via:\n"
      + "//   make ucd-generate\n"
      + "//\n"
      + "// Source: UnicodeData.txt " + ucd_property + ".\n"
      + "// Only non-identity mappings are stored (value 0 = identity);\n"
      + "// `of` returns `cp` for those so the API is identity-preserving."
    let body = SimpleCaseFoldEmitter.of_body(c_prefix)
    _TrieEmitter.emit_u32(header, primitive_name, c_prefix, values, body)

  fun _collect(
    entries: ReadSeq[UnicodeDataEntry val] box,
    kind: String val)
    : Array[(U32, U32)] val
  =>
    let out = recover trn Array[(U32, U32)] end
    for e in entries.values() do
      let mapped: (U32 | None) =
        if kind == "simple_upper" then e.simple_upper
        elseif kind == "simple_lower" then e.simple_lower
        else e.simple_title
        end
      match mapped
      | let m: U32 if m != e.codepoint => out.push((e.codepoint, m))
      | let _: U32 => None
      | None => None
      end
    end
    consume out


primitive SimpleCaseFoldEmitter
  fun emit(pairs: Array[(U32, U32)] val): (String iso^, String iso^) =>
    """
    Emit `_ucd_simple_casefold.{pony,c}` — cp → folded cp, defaulting to
    identity (value 0). Pairs must be sorted ascending by cp.
    """
    let values = values_of(pairs)
    let header =
      "// Auto-generated by unicode-build. Do not edit by hand.\n"
      + "// Regenerate via:\n"
      + "//   make ucd-generate\n"
      + "//\n"
      + "// Source: CaseFolding.txt status C + S entries.\n"
      + "// Only non-identity mappings are stored (value 0 = identity);\n"
      + "// `of` returns `cp` for those so the API is identity-preserving."
    _TrieEmitter.emit_u32(header, "_UcdSimpleCaseFold", "ucd_scf", values,
      of_body("ucd_scf"))

  fun values_of(pairs: Array[(U32, U32)] val): Array[U32] val =>
    """
    Expand (cp, mapped) pairs into a full cp -> U32 map (0 = identity).
    Shared by every simple cp -> cp case table.
    """
    recover val
      let v = Array[U32].init(0, 0x110000)
      for p in pairs.values() do
        try v(p._1.usize())? = p._2 end
      end
      v
    end

  fun of_body(c_prefix: String val): String val =>
    """
    The `of` body for a simple cp -> cp trie: 0 means "no mapping", so
    return `cp` (identity).
    """
    "  fun of(cp: U32): U32 =>\n"
      + "    let m = @" + c_prefix + "_lookup(cp)\n"
      + "    if m == 0 then cp else m end\n"

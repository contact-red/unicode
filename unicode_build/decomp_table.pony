// Combining class + canonical decomposition table generator.
//
// Two output tables, both ASCII-hex-pair encoded (see category_table.pony
// for the encoding rationale):
//
//   _UcdCombiningClass : cp → U8
//     Only codepoints with non-zero Canonical_Combining_Class get an
//     entry; lookups default to 0.
//     Record layout (per entry): 5 bytes raw / 10 hex chars
//       chars 0..7  : cp (LE U32, 8 hex)
//       chars 8..9  : CCC (1 byte, 2 hex)
//
//   _UcdCanonicalDecomposition : cp → (Array[U32] val | None)
//     Only codepoints with a non-empty canonical decomposition (no
//     `<...>` compatibility tag) get an entry. The decomposition is at
//     most 2 codepoints (this is true throughout the UCD; Hangul
//     decomposition is algorithmic and computed at runtime).
//     Record layout (per entry): 12 bytes raw / 24 hex chars
//       chars 0..7   : cp (LE U32)
//       chars 8..15  : decomp[0] (LE U32)
//       chars 16..23 : decomp[1] (LE U32; 0 if single-codepoint decomp)

primitive DecompTableEmitter
  fun emit_combining_class(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : String iso^
  =>
    """
    Generate the contents of `unicode/_ucd_combining_class.pony`.
    """
    // Materialize the non-zero-CCC entries as sendable val data so the
    // `recover iso` block can iterate them.
    let ccc_entries = _collect_ccc(entries)
    recover iso
      let out = String(32 * 1024)
      out.append("// Auto-generated by unicode-build. Do not edit by hand.\n")
      out.append("// Regenerate via:\n")
      out.append("//   make ucd-generate\n")
      out.append("//\n")
      out.append("// Source: UnicodeData.txt Canonical_Combining_Class field.\n")
      out.append("// Only non-zero entries are stored; lookups default to 0.\n\n")

      out.append("primitive _UcdCombiningClass\n")
      out.append("  fun of(cp: U32): U8 =>\n")
      let coalesced = _coalesce_ccc(ccc_entries)
      let to_variant: {(U8): String val} val =
        {(b: U8): String val => b.string() }
      _RangeMatchEmitter.emit(out, coalesced, to_variant, "0")
      out
    end

  fun _coalesce_ccc(
    entries: Array[(U32, U8)] val): Array[(U32, U32, U8)] val
  =>
    """
    Coalesce adjacent same-class entries into ranges. The source data
    is already sorted by codepoint; many neighbouring codepoints share
    a combining class (the U+0300..U+0314 above-marks all have class
    230), so coalescing cuts the emitted arm count substantially.
    """
    recover val
      let out = Array[(U32, U32, U8)]
      var have: Bool = false
      var cur_lo: U32 = 0
      var cur_hi: U32 = 0
      var cur_v:  U8 = 0
      for e in entries.values() do
        if have and (e._1 == (cur_hi + 1)) and (e._2 == cur_v) then
          cur_hi = e._1
        else
          if have then out.push((cur_lo, cur_hi, cur_v)) end
          cur_lo = e._1
          cur_hi = e._1
          cur_v = e._2
          have = true
        end
      end
      if have then out.push((cur_lo, cur_hi, cur_v)) end
      out
    end

  fun emit_canonical_decomposition(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : String iso^
  =>
    """
    Generate the contents of `unicode/_ucd_canonical_decomp.pony`.
    """
    // Materialize canonical decomps as sendable val data.
    let decomp_entries = _collect_canonical_decomp(entries)
    recover iso
      let out = String(64 * 1024)
      out.append("// Auto-generated by unicode-build. Do not edit by hand.\n")
      out.append("// Regenerate via:\n")
      out.append("//   make ucd-generate\n")
      out.append("//\n")
      out.append("// Source: UnicodeData.txt Decomposition_Mapping field, canonical only.\n")
      out.append("// Compatibility decompositions (with `<tag>` prefix) are emitted to\n")
      out.append("// _ucd_compat_decomp.pony (used by NFKC/NFKD).\n")
      out.append("// All canonical decompositions are 1 or 2 codepoints. Hangul syllables\n")
      out.append("// are not in this table — their decomposition is algorithmic.\n\n")

      out.append("primitive _UcdCanonicalDecomp\n")
      out.append("  fun of(cp: U32): (Array[U32] val | None) =>\n")
      _emit_decomp_match(out, decomp_entries)
      out
    end

  fun _emit_decomp_match(
    out: String ref,
    entries: Array[(U32, U32, U32)] val)
  =>
    """
    Two-level dispatch for canonical-decomposition tables. Top-level
    `match cp >> 12` picks a 4096-cp bucket; inner `match cp` selects
    the exact codepoint and emits its decomposition as an
    `Array[U32] val` literal. `d1 == 0` means a single-codepoint
    decomposition.
    """
    out.append("    match cp >> 12\n")
    var prev_bucket: U32 = 0xFFFFFFFF
    var bucket_open: Bool = false
    for e in entries.values() do
      let bucket = e._1 >> 12
      if bucket != prev_bucket then
        if bucket_open then
          out.append("      else None\n")
          out.append("      end\n")
        end
        out.append("    | 0x")
        _RangeMatchEmitter.emit_hex_u32(out, bucket)
        out.append(" =>\n")
        out.append("      match cp\n")
        bucket_open = true
        prev_bucket = bucket
      end
      out.append("      | 0x")
      _RangeMatchEmitter.emit_hex_u32(out, e._1)
      out.append(" => recover val [as U32: 0x")
      _RangeMatchEmitter.emit_hex_u32(out, e._2)
      if e._3 != 0 then
        out.append("; 0x")
        _RangeMatchEmitter.emit_hex_u32(out, e._3)
      end
      out.append("] end\n")
    end
    if bucket_open then
      out.append("      else None\n")
      out.append("      end\n")
    end
    out.append("    else\n")
    out.append("      None\n")
    out.append("    end\n")

  fun _collect_ccc(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : Array[(U32, U8)] val
  =>
    """
    Pull out (codepoint, combining_class) pairs for codepoints with
    non-zero CCC.
    """
    let out = recover trn Array[(U32, U8)] end
    for e in entries.values() do
      if e.combining_class != 0 then
        out.push((e.codepoint, e.combining_class))
      end
    end
    consume out

  fun _collect_canonical_decomp(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : Array[(U32, U32, U32)] val
  =>
    """
    Pull out (codepoint, decomp[0], decomp[1]) triples for codepoints
    with a canonical (non-compatibility) decomposition. `decomp[1]` is
    0 if the decomposition is a single codepoint.
    """
    let out = recover trn Array[(U32, U32, U32)] end
    for e in entries.values() do
      if (e.decomposition.size() > 0) and (not e.is_compat_decomp) then
        let d0 = try e.decomposition(0)? else U32(0) end
        let d1 = try e.decomposition(1)? else U32(0) end
        out.push((e.codepoint, d0, d1))
      end
    end
    consume out

  fun emit_compat_decomposition(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : String iso^
  =>
    """
    Generate `unicode/_ucd_compat_decomp.pony`. Compatibility
    decompositions have variable length (1..18 codepoints in the UCD),
    so a fixed-record format would waste space. Layout:

      _index : sorted records of (cp:U32, data_offset:U32, length:U8)
               9 bytes raw / 18 hex chars per entry.
      _data  : concatenated decomposition codepoints (4 bytes each).
               Binary-searched _index gives `(offset, length)`; data is
               read from `_data` starting at `offset * 4` bytes.
    """
    let compat_entries = _collect_compat_decomp(entries)
    recover iso
      let out = String(128 * 1024)
      out.append("// Auto-generated by unicode-build. Do not edit by hand.\n")
      out.append("// Regenerate via:\n")
      out.append("//   make ucd-generate\n")
      out.append("//\n")
      out.append("// Source: UnicodeData.txt Decomposition_Mapping field,\n")
      out.append("// compatibility entries only (those with a `<...>` tag).\n")
      out.append("// Two-table layout: index (cp, offset, length) + data (cps).\n\n")

      out.append("primitive _UcdCompatDecomp\n")
      out.append("  fun of(cp: U32): (Array[U32] val | None) =>\n")
      _emit_varlen_decomp_match(out, compat_entries)
      out
    end

  fun _emit_varlen_decomp_match(
    out: String ref,
    entries: Array[(U32, Array[U32] val)] val)
  =>
    """
    Variable-length variant of `_emit_decomp_match`. Each arm emits
    an `Array[U32] val` literal containing the full compatibility
    decomposition (which can run up to ~18 codepoints).
    """
    out.append("    match cp >> 12\n")
    var prev_bucket: U32 = 0xFFFFFFFF
    var bucket_open: Bool = false
    for e in entries.values() do
      let bucket = e._1 >> 12
      if bucket != prev_bucket then
        if bucket_open then
          out.append("      else None\n")
          out.append("      end\n")
        end
        out.append("    | 0x")
        _RangeMatchEmitter.emit_hex_u32(out, bucket)
        out.append(" =>\n")
        out.append("      match cp\n")
        bucket_open = true
        prev_bucket = bucket
      end
      out.append("      | 0x")
      _RangeMatchEmitter.emit_hex_u32(out, e._1)
      out.append(" => recover val [as U32: ")
      var first: Bool = true
      for cp in e._2.values() do
        if not first then out.append("; ") end
        first = false
        out.append("0x")
        _RangeMatchEmitter.emit_hex_u32(out, cp)
      end
      out.append("] end\n")
    end
    if bucket_open then
      out.append("      else None\n")
      out.append("      end\n")
    end
    out.append("    else\n")
    out.append("      None\n")
    out.append("    end\n")

  fun _collect_compat_decomp(
    entries: ReadSeq[UnicodeDataEntry val] box)
    : Array[(U32, Array[U32] val)] val
  =>
    """
    Pull out (codepoint, decomposition) pairs for entries with a
    compatibility decomposition (tag-prefixed in UnicodeData.txt
    field 5). Sorted by codepoint for binary search at runtime.
    """
    let raw = recover trn Array[(U32, Array[U32] val)] end
    for e in entries.values() do
      if (e.decomposition.size() > 0) and e.is_compat_decomp then
        raw.push((e.codepoint, e.decomposition))
      end
    end
    // UnicodeData.txt is already sorted by codepoint, but assert by
    // building a fresh sorted out-array.
    let out = recover trn Array[(U32, Array[U32] val)](raw.size()) end
    for r in raw.values() do out.push(r) end
    consume out

  fun _emit_le_u32(out: String ref, value: U32) =>
    _emit_byte(out, U8.from[U32](value and 0xFF))
    _emit_byte(out, U8.from[U32]((value >> 8) and 0xFF))
    _emit_byte(out, U8.from[U32]((value >> 16) and 0xFF))
    _emit_byte(out, U8.from[U32]((value >> 24) and 0xFF))

  fun _emit_byte(out: String ref, b: U8) =>
    let digits = "0123456789ABCDEF"
    try out.push(digits(USize.from[U8](b >> 4))?) end
    try out.push(digits(USize.from[U8](b and 0xF))?) end
